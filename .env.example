# External Cloud Database (Supabase PostgreSQL)
# You can find these in your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Google Gemini API Key for AI Health Assistant
VITE_GEMINI_API_KEY=
